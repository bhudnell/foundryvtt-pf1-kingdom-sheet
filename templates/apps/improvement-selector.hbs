<section class="form-body {{ cssClass }}" data-tooltip-class="pf1-v2">
  {{#unless hideSearch}}
  <input type="search" name="search" value="{{ search }}" placeholder="{{localize 'PF1.SearchFilterPlaceholder'}}" />
  {{/unless}}
  <ol class="trait-list">
    {{#each choices}}
    <li data-choice="{{@key}}" data-tooltip="{{ error }}">
      <label class="checkbox">
        <input type="checkbox" name="choices.{{@key}}" data-dtype="Boolean" {{checked chosen}} {{disabled invalid}} />
        {{ label }}
      </label>
    </li>
    {{/each}}
  </ol>
</section>
